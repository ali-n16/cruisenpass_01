{
  "name": "cruisenpass",
  "version": "1.0.0",
  "private": true,
  "description": "Cruise'N'Pass driving school website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "build:assemble": "node scripts/assemble.mjs",
    "build": "npm run build:css && npm run build:assemble",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}

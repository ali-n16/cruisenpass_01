{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "no-implicit-button-type": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "no-inline-style": "off",
    "long-title": "off",
    "attribute-allowed-values": ["arctic", "Telton", "foobar"],
    "no-redundant-role": "off",
    "no-raw-characters": "off",
    "require-sri": "off",
    "no-protocol-relative-urls": "off",
    "doctype-style": "off",
    "no-omit-replaceme": "off"
  }
}
